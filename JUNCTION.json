{
    "name": "junction-test-service",
    "runtime": {
        "install": ["uv", "sync"],
        "command": [
        "uv", "run", "--no-sync",
        "uvicorn", "junction_test_service.main:app",
        "--app-dir", "src",
        "--host", "127.0.0.1",
        "--port", "8081"
        ]
    },
    "routing": {
        "prefix": "/test"
    },
    "health": {
        "path": "/health"
    }
}